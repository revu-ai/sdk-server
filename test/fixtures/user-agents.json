{
  "description": "Shared user agent fixture. Every entry carries the verdict expected on both sides of server capture: how the REVU API classifies the visitor, and whether the Server SDK reports the request at all. Both sides test against this file, so their two rules cannot drift apart.",
  "rules": {
    "api": "The class the REVU API derives from the user agent: human, bot or ai_agent. It decides what is stored and what a report counts. An unrecognized user agent is human, so a missed match stays in the net-human number rather than disappearing.",
    "sdk": "What the Server SDK does with the request: send it to REVU, or skip it. The pre-filter is deliberately generous, since the API classifies every hit again.",
    "invariant": "Every user agent the API counts as non-human must be sent, or the hit is lost. Nothing sent should be classified human, or the send was wasted and shows as a refusal. The only entries that are human and skipped are the health probes, which neither side treats as visitors.",
    "name": "The agent name the API surfaces for the non-human slice, or null for a human user agent and for an automated one that declares no usable name."
  },
  "updated": "2026-09-16",
  "groups": {
    "browser": "Real browsers, and the empty user agent",
    "search": "Search engine crawlers",
    "ai": "AI crawlers and fetchers",
    "preview": "Link preview and social fetchers",
    "seo": "SEO and backlink crawlers",
    "monitor": "Monitoring, audit and headless browsers",
    "probe": "Health check probes, deliberately never reported",
    "client": "Scripted HTTP clients: command line tools, language runtimes, API clients",
    "generic": "Crawlers with no named signature"
  },
